generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  nombre    String
  nombres   String?
  apellidos String?
  cedula    String?
  celular   String?
  email     String   @unique
  password  String
  rol       Rol      @default(RESIDENTE)
  activo    Boolean  @default(true)
  bio       String?
  foto      String?
  manzana   String?
  villa     String?
  creadoEn  DateTime @default(now())
  visitasPerfil Int  @default(0)
  posts     Post[]
  postsPublicados Post[] @relation("PostPublicadoPor")
  reservas  Reserva[]
  tokensRecuperacion TokenRecuperacion[]
  pagos              Pago[]
  pagosDecididos     Pago[]  @relation("PagoDecididoPor")

  estadoCuenta    EstadoCuenta @default(PENDIENTE)
  // Guarda al ADMIN que aprobó o rechazó la solicitud de registro.
  decididoPorId   String?
  decididoPor     User?        @relation("CuentaDecididaPor", fields: [decididoPorId], references: [id], onDelete: SetNull)
  cuentasDecididas User[]      @relation("CuentaDecididaPor")
  fechaDecision   DateTime?
  motivoRechazo   String?

  @@index([activo])
  @@index([estadoCuenta])
}

enum EstadoCuenta {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model TokenRecuperacion {
  id          String   @id @default(uuid())
  token       String   @unique
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id])
  usado       Boolean  @default(false)
  expiraEn    DateTime
  creadoEn    DateTime @default(now())
}

enum Rol {
  ADMIN
  RESIDENTE
}

model Post {
  id            String     @id @default(uuid())
  titulo        String
  descripcion   String
  tipo          TipoPost
  imagenUrl     String[]
  archivoUrl    String[]
  anclado       Boolean    @default(false)
  ancladoPerfil Boolean    @default(false)
  estado        EstadoPost @default(ACTIVO)
  creadoEn      DateTime   @default(now())
  autor         User       @relation(fields: [autorId], references: [id])
  autorId       String

  publico         Boolean   @default(false)
  enCarrusel      Boolean   @default(false)
  publicadoPorId  String?
  publicadoPor    User?     @relation("PostPublicadoPor", fields: [publicadoPorId], references: [id], onDelete: SetNull)
  publicadoEn     DateTime?

  @@index([creadoEn])
  @@index([tipo])
  @@index([autorId])
  @@index([publico])
  @@index([enCarrusel])
}

enum TipoPost {
  AVISO
  OBRA
  COMUNICADO
  EMPRENDIMIENTO
}

enum EstadoPost {
  ACTIVO
  INACTIVO
}

model Suggestion {
  id        String           @id @default(uuid())
  nombre    String
  manzana   String?
  villa     String?
  tipo      TipoSugerencia
  mensaje   String
  estado    EstadoSugerencia @default(SIN_LEER)
  creadoEn  DateTime         @default(now())

  @@index([creadoEn])
  @@index([estado])
  @@index([tipo])
}

enum TipoSugerencia {
  SUGERENCIA
  QUEJA
  CONSULTA
  OTRO
}

enum EstadoSugerencia {
  SIN_LEER
  LEIDA
  ARCHIVADA
}

enum EspacioReservable {
  CABANA_ARBOL
  CABANA_MEDIO
  CABANA_RIO
  CASA_CLUB
}

enum HorarioReserva {
  CABANA_COMPLETO
  CASA_CLUB_MATUTINO
  CASA_CLUB_VESPERTINO
  CASA_CLUB_NOCTURNO
}

enum EstadoReserva {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoCuentaBancaria {
  AHORROS
  CORRIENTE
}

enum TipoContacto {
  TELEFONO
  CORREO
  RED_SOCIAL
}

model InfoContacto {
  id         String       @id @default(uuid())
  tipo       TipoContacto
  etiqueta   String?
  plataforma String?
  valor      String
  orden      Int          @default(0)
  activo     Boolean      @default(true)
  creadoEn   DateTime     @default(now())
}

model Reserva {
  id                  String            @id @default(uuid())
  usuarioId           String
  usuario             User              @relation(fields: [usuarioId], references: [id])

  espacio             EspacioReservable
  fecha               DateTime
  horario             HorarioReserva

  manzana             String
  villa               String

  motivoEvento        String
  nombres             String
  apellidos           String
  correo              String
  celular             String
  cedula              String

  esParaTercero       Boolean           @default(false)
  terceroNombre       String?
  terceroCedula       String?
  terceroCorreo       String?
  terceroCelular      String?

  bancoNombre         String
  numeroCuenta        String
  tipoCuenta          TipoCuentaBancaria
  cedulaRucBancario   String

  montoAlquiler       Decimal
  montoGarantia       Decimal

  comprobantePagoUrls   String[]        @default([])
  listaInvitadosUrls    String[]        @default([])
  contratoFirmadoUrls   String[]        @default([])

  estado              EstadoReserva     @default(PENDIENTE)
  motivoRechazo       String?
  observacionAdmin    String?

  notificacionPendiente Boolean         @default(false)

  creadoEn            DateTime          @default(now())
  actualizadoEn       DateTime          @updatedAt
  pagos               Pago[]

  @@index([fecha])
  @@index([estado])
  @@index([usuarioId])
  @@index([espacio])
}

// Pagos (RF-39 a RF-42): de reservas y de alícuotas.
enum TipoPago {
  RESERVA
  ALICUOTA
}

enum ConceptoPago {
  ALQUILER
  GARANTIA
  ALICUOTA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  VENCIDO
  DUPLICADO
  REVERSADO
}

model Pago {
  id                 String       @id @default(uuid())
  usuarioId          String
  usuario            User         @relation(fields: [usuarioId], references: [id])
  tipo               TipoPago
  concepto           ConceptoPago
  reservaId          String?
  reserva            Reserva?     @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  cuotaId            String?
  cuota              CuotaAlicuota? @relation(fields: [cuotaId], references: [id], onDelete: Restrict)

  montoCentavos      Int
  estado             EstadoPago   @default(PENDIENTE)

  proveedor          String
  idExterno          String?
  respuestaProveedor Json?
  evidenciaUrls      String[]     @default([])

  decididoPorId      String?
  decididoPor        User?        @relation("PagoDecididoPor", fields: [decididoPorId], references: [id], onDelete: SetNull)
  motivoRechazo      String?

  creadoEn           DateTime     @default(now())
  venceEn            DateTime?
  resueltoEn         DateTime?
  actualizadoEn      DateTime     @updatedAt

  @@unique([proveedor, idExterno])
  @@index([usuarioId])
  @@index([estado])
  @@index([reservaId])
  @@index([cuotaId])
}


// Alícuotas (RF-43 a RF-45). Valor fijo mensual por villa, sin mora.
enum EstadoCuota {
  PENDIENTE
  PAGADA
  ANULADA
}

// Una sola fila (id = 1, lo exige un CHECK): los montos vigentes que el
// administrador configura. Cada cuota guarda una copia al generarse.
model ConfigAlicuota {
  id                   Int      @id @default(1)
  montoCentavos        Int
  montoPuntualCentavos Int
  diasPuntual          Int
  actualizadoEn        DateTime @updatedAt
  actualizadoPorId     String?
}

model CuotaAlicuota {
  id                   String      @id @default(uuid())
  manzana              String
  villa                String
  // 'AAAA-MM' en hora de Guayaquil.
  periodo              String
  estado               EstadoCuota @default(PENDIENTE)
  montoBaseCentavos    Int
  montoPuntualCentavos Int
  diasPuntual          Int
  creadoEn             DateTime    @default(now())
  pagadaEn             DateTime?
  pagos                Pago[]

  @@unique([manzana, villa, periodo])
  @@index([periodo])
  @@index([estado])
}
