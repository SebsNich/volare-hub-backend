generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  nombre    String
  nombres   String?
  apellidos String?
  cedula    String?
  celular   String?
  email     String   @unique
  password  String
  rol       Rol      @default(RESIDENTE)
  activo    Boolean  @default(true)
  bio       String?
  foto      String?
  manzana   String?
  villa     String?
  creadoEn  DateTime @default(now())
  visitasPerfil Int  @default(0)
  posts     Post[]
  reservas  Reserva[]
  tokensRecuperacion TokenRecuperacion[]

  @@index([activo])
}

model TokenRecuperacion {
  id          String   @id @default(uuid())
  token       String   @unique
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id])
  usado       Boolean  @default(false)
  expiraEn    DateTime
  creadoEn    DateTime @default(now())
}

enum Rol {
  ADMIN
  RESIDENTE
}

model Post {
  id            String     @id @default(uuid())
  titulo        String
  descripcion   String
  tipo          TipoPost
  imagenUrl     String[]
  archivoUrl    String[]
  anclado       Boolean    @default(false)
  ancladoPerfil Boolean    @default(false)
  estado        EstadoPost @default(ACTIVO)
  creadoEn      DateTime   @default(now())
  autor         User       @relation(fields: [autorId], references: [id])
  autorId       String

  @@index([creadoEn])
  @@index([tipo])
  @@index([autorId])
}

enum TipoPost {
  AVISO
  OBRA
  COMUNICADO
  EMPRENDIMIENTO
}

enum EstadoPost {
  ACTIVO
  INACTIVO
}

model Suggestion {
  id        String           @id @default(uuid())
  nombre    String
  manzana   String?
  villa     String?
  tipo      TipoSugerencia
  mensaje   String
  estado    EstadoSugerencia @default(SIN_LEER)
  creadoEn  DateTime         @default(now())

  @@index([creadoEn])
  @@index([estado])
  @@index([tipo])
}

enum TipoSugerencia {
  SUGERENCIA
  QUEJA
  CONSULTA
  OTRO
}

enum EstadoSugerencia {
  SIN_LEER
  LEIDA
  ARCHIVADA
}

enum EspacioReservable {
  CABANA_ARBOL
  CABANA_MEDIO
  CABANA_RIO
  CASA_CLUB
}

enum HorarioReserva {
  CABANA_COMPLETO
  CASA_CLUB_MATUTINO
  CASA_CLUB_VESPERTINO
  CASA_CLUB_NOCTURNO
}

enum EstadoReserva {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoCuentaBancaria {
  AHORROS
  CORRIENTE
}

enum TipoContacto {
  TELEFONO
  CORREO
  RED_SOCIAL
}

model InfoContacto {
  id         String       @id @default(uuid())
  tipo       TipoContacto
  etiqueta   String?
  plataforma String?
  valor      String
  orden      Int          @default(0)
  activo     Boolean      @default(true)
  creadoEn   DateTime     @default(now())
}

model Reserva {
  id                  String            @id @default(uuid())
  usuarioId           String
  usuario             User              @relation(fields: [usuarioId], references: [id])

  espacio             EspacioReservable
  fecha               DateTime
  horario             HorarioReserva

  manzana             String
  villa               String

  motivoEvento        String
  nombres             String
  apellidos           String
  correo              String
  celular             String
  cedula              String

  esParaTercero       Boolean           @default(false)
  terceroNombre       String?
  terceroCedula       String?
  terceroCorreo       String?
  terceroCelular      String?

  bancoNombre         String
  numeroCuenta        String
  tipoCuenta          TipoCuentaBancaria
  cedulaRucBancario   String

  montoAlquiler       Decimal
  montoGarantia       Decimal

  comprobantePagoUrls   String[]        @default([])
  listaInvitadosUrls    String[]        @default([])
  contratoFirmadoUrls   String[]        @default([])

  estado              EstadoReserva     @default(PENDIENTE)
  motivoRechazo       String?
  observacionAdmin    String?

  notificacionPendiente Boolean         @default(false)

  creadoEn            DateTime          @default(now())
  actualizadoEn       DateTime          @updatedAt

  @@index([fecha])
  @@index([estado])
  @@index([usuarioId])
  @@index([espacio])
}